{
    // Python interpreter - points to hatch test environment
    // If using a different Python version, update the path (e.g., py3.12, py3.13)
    "python.defaultInterpreterPath": ".venv/build/bin/python",

    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.exclude": [
        ".venv"
    ],

    "python.analysis.extraPaths": [
        "${workspaceFolder}/src"
    ],

    // Run pytest with hatch
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "tests"
    ],

    "terminal.integrated.profiles.windows": {
        "VS 2022 C++ Dev CMD": {
            "path": "cmd.exe",
            "args": [
                "/k",
                "C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat"
           ]
        },
        "VS 2022 C++ Dev CMD PowerShell": {
            "path": "powershell.exe",
            "args": [
                "-NoExit",
                "-Command",
                "& 'C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat'"
            ]
        }
    }

}